{
  "python.terminal.activateEnvironment": false,
  "python.analysis.typeCheckingMode": "basic",
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.eol": "\n",
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/build*": true,
    "**/dist*": true,
    "**/userdata": true,
    "**/shots": true,
    "**/logs": true
  },
  "search.exclude": {
    "**/_internal": true,
    "**/build*": true,
    "**/dist*": true
  }
}
