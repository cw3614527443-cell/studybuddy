{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 GUI（StudyBuddy）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "无头自检（--selftest）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--selftest"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
